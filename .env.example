AZDO_ORGANIZATION=https://dev.azure.com/your-organization
TENANT_ID=your-entra-tenant-id
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-app-registration-client-secret
REDIRECT_URI=http://localhost:8501
AZDO_SCOPE=499b84ac-1321-427f-aa17-267ca6975798/user_impersonation
# Optional administrator-only fallback. Do not use for normal users.
AZDO_ADMIN_PAT=your-azure-devops-personal-access-token
AZDO_API_VERSION=7.1
REPORTING_LOOKBACK_DAYS=365
# Comma-separated states your Azure DevOps process considers completed.
ADO_COMPLETED_STATES=Accepted,Closed,Resolved,Done,Completed
AZDO_TIME_ZONE=America/Chicago
